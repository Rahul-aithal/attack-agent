# Single-machine defaults (used when deploy.yaml is absent).
ATTACK_AGENT_MODEL_NAME=llama3.2:3b
ATTACK_AGENT_OLLAMA_HOST=http://localhost:11434

# Multi-machine routing lives in deploy.yaml (copy from deploy.example.yaml).
# ATTACK_AGENT_DEPLOY_FILE=deploy.yaml

# Profiling stop rule
ATTACK_AGENT_MIN_TURNS=8
ATTACK_AGENT_MAX_TURNS=30

# Profiler: beta (default, Beta-posterior) or v1 (legacy, for ablations)
ATTACK_AGENT_PROFILER_VERSION=beta

# Signal extractor: llm (default) or keyword (ablation / offline)
ATTACK_AGENT_EXTRACTOR_MODE=llm

# Strategy selection: literature_map | twin_driven | random | fixed:<principle>
ATTACK_AGENT_SELECTION_MODE=literature_map

# Who presents the simulated request: agent (the chat assistant itself, mid-conversation) or
# contact (a separate fictional "IT Support" contact). Participants consent to both at join.
ATTACK_AGENT_SCENARIO_SENDER=agent

# Storage / outputs
ATTACK_AGENT_OUTPUT_DIR=outputs
ATTACK_AGENT_DATABASE_URL=sqlite:///outputs/attack_agent.db

# API server
ATTACK_AGENT_API_HOST=0.0.0.0
ATTACK_AGENT_API_PORT=8000
# Leave blank to auto-generate and print an admin token at startup.
ATTACK_AGENT_ADMIN_TOKEN=
# Allow participants to start a session without the admin token.
ATTACK_AGENT_PUBLIC_SESSIONS=true

# BYOK keys (only needed if deploy.yaml references them). Kept in memory, never written to disk.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
